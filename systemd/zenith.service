[Unit]
Description=Zenith Gaming Daemon - Ultra-low Latency Game Optimizer
Documentation=https://github.com/negg0s/zenith-gaming-daemon
After=multi-user.target pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/zenith daemon
Restart=on-failure
RestartSec=3
WatchdogSec=15
ExecStopPost=/usr/bin/zenith --rollback

# Privilege & Capabilities
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_ADMIN CAP_SYS_RESOURCE
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_ADMIN CAP_SYS_RESOURCE

# Filesystem Isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=no
PrivateDevices=no

# Minimum required write paths
ReadWritePaths=/run/zenith /sys/fs/cgroup /proc/sys/kernel /proc/sys/vm /proc/sys/net/core /sys/kernel/mm/transparent_hugepage /sys/class/drm

# System Call & Kernel Surface Hardening
SystemCallArchitectures=native
SystemCallFilter=@system-service @system-service-for-cgroups
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
